<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        x:Class="VideoBatchProcessor.App.MainWindow"
        Title="Video Batch Processor"
        Width="1320" Height="820"
        MinWidth="1080" MinHeight="680">

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Background="#F7F9FB" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Image Source="avares://VideoBatchProcessor.App/Assets/Branding/ifc-logo.png"
                 Width="58" Height="48" Stretch="Uniform" />
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="Video Batch Processor" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A" />
            <TextBlock Text="Preprocesamiento científico de video" FontSize="13" Foreground="#64748B" />
          </StackPanel>
        </StackPanel>
        <Image Grid.Column="1" Source="avares://VideoBatchProcessor.App/Assets/Branding/unam-logo-blue.png"
               Width="58" Height="44" Stretch="Uniform" Opacity="0.9" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#F7F9FB" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Background="#0F172A" CornerRadius="14" Width="28" Height="28">
            <TextBlock Text="1" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Sesiones" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0F172A" />
        </StackPanel>
        <Border Width="56" Height="1" Background="#E2E8F0" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.58">
          <Border Background="#E2E8F0" CornerRadius="14" Width="28" Height="28">
            <TextBlock Text="2" Foreground="#64748B" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Cámara y luces" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#64748B" />
        </StackPanel>
        <Border Width="56" Height="1" Background="#E2E8F0" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.58">
          <Border Background="#E2E8F0" CornerRadius="14" Width="28" Height="28">
            <TextBlock Text="3" Foreground="#64748B" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Revisión y resultados" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#64748B" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="238,*,330">
      <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
          <Border Background="#E6E8EA" CornerRadius="6" Padding="12">
            <StackPanel Spacing="3">
              <TextBlock Text="Video Batch Processor" FontWeight="SemiBold" Foreground="#0F172A" />
              <TextBlock Text="Configuración de sesiones" FontSize="12" Foreground="#64748B" />
            </StackPanel>
          </Border>
          <Button Grid.Row="1" Classes="primary" Click="NewBatch_Click" HorizontalAlignment="Stretch" Margin="0,10,0,0">Nuevo lote</Button>
          <Border Grid.Row="2" Background="#0F172A" CornerRadius="4" Padding="12,10" Margin="0,10,0,0">
            <TextBlock Text="Sesiones" Foreground="White" FontWeight="SemiBold" />
          </Border>
          <StackPanel Grid.Row="3" Spacing="4" Opacity="0.52" Margin="0,10,0,0">
            <Border Padding="12,10"><TextBlock Text="Cámara y luces" Foreground="#475569" /></Border>
            <Border Padding="12,10"><TextBlock Text="Revisión" Foreground="#475569" /></Border>
            <Border Padding="12,10"><TextBlock Text="Exportación" Foreground="#475569" /></Border>
          </StackPanel>
          <TextBlock Grid.Row="5" Text="Paso actual: confirmar sesiones y sus fuentes conductuales antes de procesar."
                     TextWrapping="Wrap" FontSize="12" Foreground="#64748B" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" Padding="28,26" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="Sesiones" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A" />
              <TextBlock x:Name="SummaryText" Text="Selecciona una carpeta o agrega videos para comenzar."
                         Foreground="#64748B" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="secondary" Click="OpenFolder_Click">Seleccionar carpeta</Button>
              <Button Classes="primary" Click="AddFiles_Click">Agregar videos</Button>
            </StackPanel>
          </Grid>

          <Border Classes="card" BorderBrush="#94A3B8" BorderThickness="2" Padding="36" MinHeight="170">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <TextBlock Text="Carga videos de laboratorio" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center" />
              <TextBlock Text="Selecciona una carpeta completa o agrega archivos MP4, AVI, MOV, MKV y M4V."
                         Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button Classes="secondary" Click="OpenFolder_Click">Carpeta</Button>
                <Button Classes="secondary" Click="AddFiles_Click">Archivos</Button>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card" MinHeight="290">
            <Grid RowDefinitions="Auto,*">
              <Border Background="#F1F5F9" Padding="16,12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="SESIONES CARGADAS" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" />
                    <TextBlock Text="Revisa nombre, metadata y fuente conductual." FontSize="12" Foreground="#64748B" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="Los videos fuente no se modifican." FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <dg:DataGrid Grid.Row="1" x:Name="SessionsGrid"
                           AutoGenerateColumns="False" IsReadOnly="True"
                           SelectionChanged="SessionsGrid_SelectionChanged"
                           GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                           Background="White" BorderThickness="0" MinHeight="220">
                <dg:DataGrid.Columns>
                  <dg:DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="135" />
                  <dg:DataGridTextColumn Header="Archivo" Binding="{Binding FileName}" Width="2*" />
                  <dg:DataGridTextColumn Header="Fuente conductual" Binding="{Binding BehavioralSource}" Width="1.7*" />
                  <dg:DataGridTextColumn Header="Fase" Binding="{Binding Phase}" Width="70" />
                  <dg:DataGridTextColumn Header="Día" Binding="{Binding Day}" Width="55" />
                  <dg:DataGridTextColumn Header="Rata" Binding="{Binding Rat}" Width="55" />
                  <dg:DataGridTextColumn Header="Pendiente" Binding="{Binding MissingFields}" Width="1.5*" />
                </dg:DataGrid.Columns>
              </dg:DataGrid>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="2" Background="#F7F9FB" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Padding="22">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Text="Detalle de sesión" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A" />
            <TextBlock x:Name="SelectedFileText" Text="Selecciona una sesión de la tabla." TextWrapping="Wrap" Foreground="#64748B" />
          </StackPanel>

          <Border Grid.Row="1" Classes="card" Padding="14" Margin="0,14,0,0">
            <StackPanel Spacing="6">
              <TextBlock Text="FUENTE CONDUCTUAL" Classes="label" />
              <TextBlock x:Name="SelectedSourceText" Text="Aún no hay una sesión seleccionada." TextWrapping="Wrap" Foreground="#0F172A" />
              <TextBlock x:Name="SourceNoticeText" TextWrapping="Wrap" Foreground="#64748B" FontSize="12" />
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,14">
            <StackPanel x:Name="SelectionPanel" IsVisible="False" Spacing="12">
              <Border Classes="card" Padding="14">
                <StackPanel Spacing="6">
                  <TextBlock Text="METADATA DE SESIÓN" Classes="label" />
                  <TextBlock x:Name="SelectedStatusText" TextWrapping="Wrap" Foreground="#475569" />
                  <StackPanel x:Name="MetadataFieldsPanel" Spacing="8" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="3" Spacing="8">
            <Button x:Name="ApplyMetadataButton" Classes="primary" Click="CompleteMetadata_Click"
                    IsVisible="False" HorizontalAlignment="Stretch">Aplicar metadata</Button>
            <TextBlock x:Name="FormStatusText" TextWrapping="Wrap" FontSize="12" Foreground="#64748B" />
            <Button Classes="secondary" IsEnabled="False" HorizontalAlignment="Stretch">Continuar a cámara y luces</Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="#E6E8EA" BorderBrush="#D8DADC" BorderThickness="0,1,0,0" Padding="24,10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Estado global: configuración de sesiones" FontSize="12" Foreground="#475569" />
        <TextBlock Grid.Column="1" Text="Procesamiento y exportación se habilitarán al completar sus módulos." FontSize="12" Foreground="#64748B" />
      </Grid>
    </Border>
  </Grid>
</Window>
